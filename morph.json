{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-3d-gen",
  "version": "2.2.0",
  "description": "NON FONCTIONNEL (squelette d'API) — Extension autonome de génération d'objets et maillages 3D (InstantMesh, TripoSR, Shap-E, GLTF/OBJ) avec son interface de studio intégrée. Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-3d-gen",
  "repository": "https://github.com/Locaryn/morph-3d-gen",
  "keywords": [
    "3d-generation",
    "mesh",
    "gltf",
    "obj",
    "3d-asset",
    "instantmesh",
    "triposr"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur 3D local fourni par l'extension."
    },
    "files.read": {
      "reason": "Lire les modèles 3D et images sources du stockage de l'extension."
    },
    "files.write": {
      "reason": "Écrire les maillages générés et les textures produites."
    },
    "network": {
      "reason": "Télécharger les modèles 3D depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "3d-gen"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "3d-gen-catalog",
        "slot": "marketplace.catalogs",
        "order": 20,
        "type": "data",
        "label": "Modèles de génération 3D",
        "icon": "cube",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute le filtre « Génération 3D » et ses modèles au catalogue"
      },
      {
        "id": "3d-gen-studio",
        "slot": "studio.tabs",
        "order": 20,
        "label": "Génération 3D",
        "icon": "cube",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-3d-gen-panel",
        "hint": "Génération et visualisation de maillages 3D"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.2.0",
      "is_beta": false,
      "summary": "L'interface Studio n'affiche plus jamais un fichier fabriqué quand le pont d'extension est indisponible : elle échoue franchement, comme le fait déjà le moteur. Retire le doublon d'entrée « studio » du menu, source d'une mise en page cassée (Locaryn/Locaryn#7).",
      "tag": "v2.2.0",
      "released_at": "2026-09-17",
      "install_source": "Locaryn/morph-3d-gen#v2.2.0"
    },
    {
      "version": "2.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-3d-gen#v2.1.0-beta.1"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-3d-gen#v2.0.0"
    },
    {
      "version": "1.5.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.5.0",
      "tag": "v1.5.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-3d-gen#v1.5.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-3d-gen#v1.0.0"
    }
  ]
}
