{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-3d-gen",
  "version": "1.0.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Extension autonome de génération d'objets et maillages 3D (InstantMesh, TripoSR, Shap-E, GLTF/OBJ) avec son interface de studio intégrée. Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-3d-gen",
  "repository": "https://github.com/Locaryn/morph-3d-gen",
  "keywords": [
    "3d-generation",
    "mesh",
    "gltf",
    "obj",
    "3d-asset",
    "instantmesh",
    "triposr"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur 3D local fourni par l'extension."
    },
    "files.read": {
      "reason": "Lire les modèles 3D et images sources du stockage de l'extension."
    },
    "files.write": {
      "reason": "Écrire les maillages générés et les textures produites."
    },
    "network": {
      "reason": "Télécharger les modèles 3D depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "3d-gen"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "3d-gen-catalog",
        "slot": "marketplace.catalogs",
        "order": 20,
        "type": "data",
        "label": "Modèles de génération 3D",
        "icon": "cube",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute le filtre « Génération 3D » et ses modèles au catalogue"
      },
      {
        "id": "3d-gen-studio",
        "slot": "studio.tabs",
        "order": 20,
        "label": "Génération 3D",
        "icon": "cube",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-3d-gen-panel",
        "hint": "Génération et visualisation de maillages 3D"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
